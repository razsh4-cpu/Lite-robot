[Unit]
Description=Lite3 optional Xbox connection and availability monitor
Wants=bluetooth.service
After=bluetooth.service network.target
OnSuccess=lite3-local-xbox-control.service

[Service]
Type=simple
User=abx
Group=abx
SupplementaryGroups=input bluetooth
WorkingDirectory=/home/abx/Lite-robot
ExecStartPre=+/usr/sbin/rfkill unblock bluetooth
ExecStartPre=+/usr/sbin/modprobe hid_xpadneo
ExecStartPre=+/usr/bin/bluetoothctl power on
ExecStart=/home/abx/Lite-robot/scripts/lite3_xbox_connection_monitor.sh
Restart=no
TimeoutStopSec=15
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
