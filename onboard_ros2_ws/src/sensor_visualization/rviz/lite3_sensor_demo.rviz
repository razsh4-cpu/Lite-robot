Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: D455 RGB-coloured 3D point cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera/depth/color/points
      Style: Points
      Size (m): 0.008
      Size (Pixels): 2
      Color Transformer: RGB8
      Position Transformer: XYZ
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: RPLIDAR S2 2D scan (independent laser frame)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Style: Points
      Size (m): 0.03
      Use Fixed Frame: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: Driver-provided camera frames
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: D455 RGB video
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/camera/color/image_raw
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: D455 aligned depth
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/camera/aligned_depth_to_color/image_raw
      Transport Hint: raw
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_depth_optical_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Orbit
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
  X: 20
  Y: 20
