Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: false
      Reference Frame: <Fixed Frame>
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Image
      Name: D455 color image
      Enabled: true
      Topic:
        Value: /camera/camera/color/image_raw
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: D455 depth image
      Enabled: true
      Topic:
        Value: /camera/camera/depth/image_rect_raw
      Transport Hint: raw
    - Class: rviz_default_plugins/PointCloud2
      Name: D455 colored point cloud
      Enabled: false
      Topic:
        Value: /camera/camera/depth/color/points
      Style: Points
      Size (Pixels): 3
      Color Transformer: RGB8
      Decay Time: 0
    - Class: rviz_default_plugins/LaserScan
      Name: RPLIDAR S2 scan
      Enabled: false
      Topic:
        Value: /scan
      Style: Points
      Size (Pixels): 5
      Color: 255; 0; 0
      Decay Time: 0
    - Class: rviz_default_plugins/Map
      Name: SLAM map
      Enabled: true
      Topic:
        Value: /map
      Alpha: 0.7
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL estimated pose
      Enabled: false
      Topic:
        Value: /amcl_pose
      Shape: Arrow
      Color: 0; 255; 0
      Alpha: 1
      Axes Length: 1.5
      Axes Radius: 0.08
      Shaft Length: 1.0
      Shaft Radius: 0.08
      Head Length: 0.5
      Head Radius: 0.18
    - Class: rviz_default_plugins/Marker
      Name: AMCL location arrow
      Enabled: true
      Topic:
        Value: /amcl_marker
    - Class: rviz_default_plugins/Map
      Name: Nav2 global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
      Alpha: 0.55
    - Class: rviz_default_plugins/Path
      Name: Planned path (no motion)
      Enabled: true
      Topic:
        Value: /planned_path
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.08
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 7
      X: -3.03045
      Y: 0.04856
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1440
  X: 30
  Y: 30
